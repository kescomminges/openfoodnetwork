#!/usr/bin/env bash
# =============================================================================
# bin/setup — Configuration initiale après un clone de kesco_custom2
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(dirname "$SCRIPT_DIR")"

echo "📦 Initialisation de l'instance Kescomminges OFN..."
echo ""

# Créer les symlinks .env → KESCOMMINGES/
cd "$APP_DIR"

KESCOMMINGES_DIR="$APP_DIR/KESCOMMINGES"
if [ ! -d "$KESCOMMINGES_DIR" ]; then
  echo "❌ Erreur : KESCOMMINGES/ introuvable"
  echo "   Clonez le dépôt privé :"
  echo "   git clone git@github.com:kescomminges/KESCOMMINGES.git KESCOMMINGES"
  exit 1
fi

echo "✓ Création des symlinks secrets..."

# .env (prod)
if [ ! -L .env ] || [ "$(readlink .env 2>/dev/null)" != "KESCOMMINGES/.env" ]; then
  rm -f .env
  ln -s KESCOMMINGES/.env .env
  echo "  ✓ .env → KESCOMMINGES/.env"
fi

# .env.dev (dev)
if [ -f KESCOMMINGES/.env.dev ]; then
  if [ ! -L .env.dev ] || [ "$(readlink .env.dev 2>/dev/null)" != "KESCOMMINGES/.env.dev" ]; then
    rm -f .env.dev
    ln -s KESCOMMINGES/.env.dev .env.dev
    echo "  ✓ .env.dev → KESCOMMINGES/.env.dev"
  fi
fi

# config/master.key
if [ -f KESCOMMINGES/master.key ]; then
  mkdir -p config
  if [ ! -L config/master.key ] || [ "$(readlink config/master.key 2>/dev/null)" != "../KESCOMMINGES/master.key" ]; then
    rm -f config/master.key
    ln -s ../KESCOMMINGES/master.key config/master.key
    echo "  ✓ config/master.key → KESCOMMINGES/master.key"
  fi
fi

echo ""
echo "✅ Setup terminé!"
echo ""
echo "Prochaines étapes :"
echo "  bundle install"
echo "  yarn install"
echo "  ./bin/deploy deploy   (en prod)"
echo "  ./bin/deploy deploy --env=dev (en dev)"
