# Set default behavior to automatically normalize line endings.
* text=auto

# Set line endings to LF, even on Windows. Otherwise, execution within Docker fails.
# See https://docs.github.com/en/get-started/getting-started-with-git/configuring-git-to-handle-line-endings#per-repository-settings
*.sh text eol=lf

# Same thing for following files, but they don't have an sh extension
pre-commit eol=lf
webpack-dev-server eol=lf

# git-crypt — fichiers chiffrés dans le dépôt (illisibles sans la clé)
# Initialiser avec : git-crypt init && git-crypt export-key ~/kescomminges-ofn-secrets.key
# Déverrouiller avec : git-crypt unlock ~/kescomminges-ofn-secrets.key
.env filter=git-crypt diff=git-crypt
.env.dev filter=git-crypt diff=git-crypt
config/master.key filter=git-crypt diff=git-crypt
config/newrelic.yml filter=git-crypt diff=git-crypt
