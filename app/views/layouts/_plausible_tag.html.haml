- if Spree::Config.plausible_domain.present? && Spree::Config.plausible_script_url.present?
  %script{ defer: true,
           "data-domain": Spree::Config.plausible_domain,
           src: Spree::Config.plausible_script_url }
  :javascript
    window.plausible = window.plausible || function() {
      (window.plausible.q = window.plausible.q || []).push(arguments)
    }
