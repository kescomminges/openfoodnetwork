[Unit]
Description=Puma HTTP Server — Kescomminges OFN DEV
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple

User=kescomminges
Group=kescomminges
WorkingDirectory=/home/kescomminges/ofn/openfoodnetwork-dev

# Variables d'environnement de l'instance dev
EnvironmentFile=/home/kescomminges/ofn/openfoodnetwork-dev/.env.dev

# Rails + rbenv
Environment=RAILS_ENV=production
Environment=DISABLE_SPRING=1
Environment=RBENV_ROOT=/home/kescomminges/.rbenv
Environment=PATH=/home/kescomminges/.rbenv/shims:/home/kescomminges/.rbenv/bin:/usr/local/bin:/usr/bin:/bin

# Puma écoute sur le port 3001 (prod = 3000)
ExecStart=/home/kescomminges/.rbenv/shims/bundle exec puma \
  --config config/puma.rb \
  --environment production \
  --bind tcp://127.0.0.1:3001

ExecReload=/bin/kill -SIGUSR1 $MAINPID

Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=puma-ofn-dev

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
