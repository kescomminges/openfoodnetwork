[Unit]
Description=Puma HTTP Server — Kescomminges OFN
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple

User=kescomminges
Group=kescomminges
WorkingDirectory=/home/kescomminges/ofn/openfoodnetwork

# Variables d'environnement de l'application
EnvironmentFile=/home/kescomminges/ofn/openfoodnetwork/.env

# Rails + rbenv
Environment=RAILS_ENV=production
Environment=DISABLE_SPRING=1
Environment=RBENV_ROOT=/home/kescomminges/.rbenv
Environment=PATH=/home/kescomminges/.rbenv/shims:/home/kescomminges/.rbenv/bin:/usr/local/bin:/usr/bin:/bin

# Puma écoute sur localhost uniquement (nginx en reverse proxy)
ExecStart=/home/kescomminges/.rbenv/shims/bundle exec puma \
  --config config/puma.rb \
  --environment production

# Reload zero-downtime (SIGUSR1 = redémarrage progressif des workers)
ExecReload=/bin/kill -SIGUSR1 $MAINPID

Restart=on-failure
RestartSec=5s

# Laisser le temps à Puma de démarrer (preload_app + workers)
TimeoutStartSec=120s
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=puma-ofn

# Durcissement sécurité
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
