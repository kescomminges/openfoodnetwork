[Unit]
Description=Sidekiq Background Worker — Kescomminges OFN
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple

User=kescomminges
Group=kescomminges
WorkingDirectory=/home/kescomminges/ofn/openfoodnetwork

EnvironmentFile=/home/kescomminges/ofn/openfoodnetwork/.env

Environment=RAILS_ENV=production
Environment=DISABLE_SPRING=1
Environment=RBENV_ROOT=/home/kescomminges/.rbenv
Environment=PATH=/home/kescomminges/.rbenv/shims:/home/kescomminges/.rbenv/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/home/kescomminges/.rbenv/shims/bundle exec sidekiq \
  --queue mailers \
  --queue default \
  --config config/sidekiq.yml \
  --environment production

TimeoutStartSec=120s

# Signal d'arrêt propre — Sidekiq finit les jobs en cours avant de s'arrêter
ExecReload=/bin/kill -TSTP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sidekiq-ofn

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
